# Database – PostgreSQL (required for production, use Neon/Supabase/Vercel Postgres)
# Example Neon: postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://..."

# NextAuth
NEXTAUTH_SECRET="generate-a-long-random-string-here"
# Local: http://localhost:3000 | Production: https://ton-domaine.com (sans slash final)
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — leave unset to hide “Continue with Google”)
# GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="..."
# After changing the public domain, update Google Cloud Console → APIs & Services → Credentials → your OAuth client:
#   - Authorized JavaScript origins: https://ton-domaine.com
#   - Authorized redirect URIs: https://ton-domaine.com/api/auth/callback/google
# And set NEXTAUTH_URL on Vercel to the same https://ton-domaine.com

# Stripe (one-time payment)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID="price_..."

# Optional: Serper API key for server-side (users usually store the key in app Settings)
# SERPER_API_KEY="..."
